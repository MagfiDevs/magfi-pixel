___TESTS___

scenarios:
- name: Fires pixel with correct parameters
  code: |-
    const mockData = {
      trackingId: 'TRK-12345',
      eventType: 'page_view',
      cookieName: 'mgfcid',
      cookieDays: '30',
      gtmOnSuccess: () => {},
      gtmOnFailure: () => {}
    };

    mock('sendPixel', function(url, onSuccess, onFailure) {
      assertThat(url).contains('tid=TRK-12345');
      assertThat(url).contains('et=page_view');
      assertThat(url).contains('community_id=100');
      assertThat(url).contains('ads_id=200');
      assertThat(url).contains('match_id=300');
      onSuccess();
    });

    mock('isConsentGranted', function() { return true; });
    mock('setCookie', function() {});
    mock('getCookieValues', function() { return []; });
    mock('getQueryParameters', function(key) {
      if (key === 'mgfclid') return 'mgf.1.100.200.300.1670000000000.98765432100000';
      return '';
    });
    mock('getUrl', function(component) {
      if (component === 'host') return 'example.com';
      if (component === 'path') return '/page';
      return '';
    });
    mock('getReferrerUrl', function(component) {
      if (component === 'host') return 'google.com';
      if (component === 'path') return '/';
      return '';
    });
    mock('queryPermission', function() { return true; });

    runCode(mockData);

- name: Respects consent mode - does not fire without consent
  code: |-
    const mockData = {
      trackingId: 'TRK-12345',
      eventType: 'page_view',
      gtmOnSuccess: () => {},
      gtmOnFailure: () => {}
    };

    let pixelSent = false;
    mock('sendPixel', function() { pixelSent = true; });
    mock('isConsentGranted', function() { return false; });
    mock('addConsentListener', function() {});

    runCode(mockData);

    assertThat(pixelSent).isFalse();

- name: Reads click ID from URL and persists in cookie
  code: |-
    const mockData = {
      trackingId: 'TRK-12345',
      eventType: 'page_view',
      cookieName: 'mgfcid',
      cookieDays: '30',
      gtmOnSuccess: () => {},
      gtmOnFailure: () => {}
    };

    let cookiesSet = {};
    mock('setCookie', function(name, value, options) {
      cookiesSet[name] = value;
    });

    mock('isConsentGranted', function() { return true; });
    mock('getCookieValues', function() { return []; });
    mock('getQueryParameters', function(key) {
      if (key === 'mgfclid') return 'mgf.1.101.201.301.1670000000001.98765432100001';
      return '';
    });
    mock('getUrl', function(component) {
      return 'example.com';
    });
    mock('getReferrerUrl', function() { return ''; });
    mock('queryPermission', function() { return true; });
    mock('sendPixel', function(url, s, f) {
      assertThat(url).contains('cid=mgf.1.101.201.301.1670000000001.98765432100001');
      assertThat(url).contains('community_id=101');
      assertThat(url).contains('ads_id=201');
      assertThat(url).contains('match_id=301');
      s();
    });

    runCode(mockData);

    assertThat(cookiesSet['mgfcid_cid']).isEqualTo('mgf.1.101.201.301.1670000000001.98765432100001');

- name: Creates persistent user ID and first-touch click ID on first ad visit
  code: |-
    const mockData = {
      trackingId: 'TRK-12345',
      eventType: 'page_view',
      cookieName: 'mgfcid',
      cookieDays: '30',
      gtmOnSuccess: () => {},
      gtmOnFailure: () => {}
    };

    let cookiesSet = {};
    mock('setCookie', function(name, value, options) {
      cookiesSet[name] = value;
    });

    mock('isConsentGranted', function() { return true; });
    mock('getCookieValues', function() { return []; });
    mock('getQueryParameters', function(key) {
      if (key === 'mgfclid') return 'mgf.1.100.200.300.1670000000000.98765432100000';
      return '';
    });
    mock('getUrl', function(component) {
      if (component === 'host') return 'example.com';
      if (component === 'path') return '/page';
      return '';
    });
    mock('getReferrerUrl', function() { return ''; });
    mock('queryPermission', function() { return true; });
    mock('sendPixel', function(url, s, f) {
      assertThat(url).contains('uid=');
      assertThat(url).contains('fcid=mgf.1.100.200.300.1670000000000.98765432100000');
      assertThat(url).contains('fc_community_id=100');
      assertThat(url).contains('fc_ads_id=200');
      s();
    });

    runCode(mockData);

    assertThat(cookiesSet['mgfcid_uid']).isNotEqualTo(undefined);
    assertThat(cookiesSet['mgfcid_fcid']).isEqualTo('mgf.1.100.200.300.1670000000000.98765432100000');

- name: Preserves first-touch click ID on returning visitor with new ad click
  code: |-
    const mockData = {
      trackingId: 'TRK-12345',
      eventType: 'purchase',
      cookieName: 'mgfcid',
      cookieDays: '30',
      gtmOnSuccess: () => {},
      gtmOnFailure: () => {}
    };

    mock('isConsentGranted', function() { return true; });
    mock('getCookieValues', function(name) {
      if (name === 'mgfcid') return ['s_existing_session'];
      if (name === 'mgfcid_uid') return ['u_existing_user_123'];
      if (name === 'mgfcid_fcid') return ['mgf.1.50.60.70.1660000000000.11111111100000'];
      return [];
    });
    mock('getQueryParameters', function(key) {
      if (key === 'mgfclid') return 'mgf.1.100.200.300.1670000000000.98765432100000';
      return '';
    });
    mock('getUrl', function(component) {
      if (component === 'host') return 'example.com';
      if (component === 'path') return '/checkout';
      return '';
    });
    mock('getReferrerUrl', function() { return ''; });
    mock('queryPermission', function() { return true; });
    mock('sendPixel', function(url, s, f) {
      // Last-touch: new click ID
      assertThat(url).contains('cid=mgf.1.100.200.300.1670000000000.98765432100000');
      assertThat(url).contains('community_id=100');
      assertThat(url).contains('ads_id=200');
      // First-touch: preserved original click ID
      assertThat(url).contains('fcid=mgf.1.50.60.70.1660000000000.11111111100000');
      assertThat(url).contains('fc_community_id=50');
      assertThat(url).contains('fc_ads_id=60');
      // User ID: preserved existing
      assertThat(url).contains('uid=u_existing_user_123');
      s();
    });

    runCode(mockData);

- name: Does not fire pixel for organic visit without a click ID
  code: |-
    let pixelSent = false;
    let successCalled = false;
    const mockData = {
      trackingId: 'TRK-12345',
      eventType: 'page_view',
      cookieName: 'mgfcid',
      cookieDays: '30',
      gtmOnSuccess: () => { successCalled = true; },
      gtmOnFailure: () => {}
    };

    mock('isConsentGranted', function() { return true; });
    mock('setCookie', function() {});
    mock('getCookieValues', function() { return []; });
    mock('getQueryParameters', function() { return ''; });
    mock('getUrl', function() { return 'example.com'; });
    mock('getReferrerUrl', function() { return ''; });
    mock('queryPermission', function() { return true; });
    mock('sendPixel', function() { pixelSent = true; });

    runCode(mockData);

    // No Magfi click ID anywhere → nothing is sent, but the tag still succeeds.
    assertThat(pixelSent).isFalse();
    assertThat(successCalled).isTrue();

