___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Sandbox API imports
const sendPixel = require('sendPixel');
const setCookie = require('setCookie');
const getCookieValues = require('getCookieValues');
const getUrl = require('getUrl');
const getQueryParameters = require('getQueryParameters');
const generateRandom = require('generateRandom');
const getTimestampMillis = require('getTimestampMillis');
const encodeUriComponent = require('encodeUriComponent');
const queryPermission = require('queryPermission');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');
const getReferrerUrl = require('getReferrerUrl');

// --- Consent Check ---
// Respect Google Consent Mode v2
const consentGranted = isConsentGranted('analytics_storage');

if (!consentGranted) {
  addConsentListener('analytics_storage', function(consentType, granted) {
    if (granted) {
      executeTag();
    }
  });

  data.gtmOnSuccess();
  return;
}

executeTag();

function executeTag() {
  // --- Config ---
  const trackingId = data.trackingId;
  const eventType = data.eventType === 'custom' ? data.customEventName : data.eventType;
  const clickIdParam = 'mgfclid';
  const endpoint = 'https://events.magfiads.com/gtm/api/v1/events';
  const cookieName = data.cookieName || 'mgfcid';
  const cookieDays = data.cookieDays || '30';

  if (!trackingId || !eventType) {
    data.gtmOnFailure();
    return;
  }

  // --- Click ID: fresh from the ad-click URL, or persisted from a prior landing ---
  var clickIdCookie = cookieName + '_cid';
  var urlClickId = getQueryParameters(clickIdParam) || '';
  var clickId = urlClickId;
  if (!clickId) {
    // No click ID in URL — fall back to the click ID persisted from an earlier
    // ad-click landing (subsequent page views within the same journey).
    var cidCookies = getCookieValues(clickIdCookie);
    if (cidCookies && cidCookies.length > 0) {
      clickId = cidCookies[0];
    }
  }

  // Only track visits that carry a Magfi click ID (fresh from the URL or persisted
  // in the cookie from an earlier ad click). Organic visits with no click ID are
  // NOT tracked — no pixel is sent, so nothing is written to the backend.
  if (!clickId) {
    data.gtmOnSuccess();
    return;
  }

  // --- Session ID (cookie-based) ---
  var sessionId = '';
  var existingCookies = getCookieValues(cookieName);
  if (existingCookies && existingCookies.length > 0) {
    sessionId = existingCookies[0];
  }

  // A fresh click ID in the URL starts a new session (new ad click); otherwise
  // reuse the existing session cookie (minting one only if it is somehow absent).
  if (urlClickId || !sessionId) {
    sessionId = generateSessionId();
    setTrackingCookie(cookieName, sessionId, cookieDays);
  }

  // --- Persist click ID in cookie for subsequent page views ---
  setTrackingCookie(clickIdCookie, clickId, cookieDays);

  // --- Persistent User ID (cross-session tracking) ---
  var userIdCookie = cookieName + '_uid';
  var userId = '';
  var existingUid = getCookieValues(userIdCookie);
  if (existingUid && existingUid.length > 0) {
    userId = existingUid[0];
    setTrackingCookie(userIdCookie, userId, 365);
  } else {
    userId = 'u_' + generateRandom(100000000, 999999999) + '_' + getTimestampMillis();
    setTrackingCookie(userIdCookie, userId, 365);
  }

  // --- First-touch Click ID (never overwritten) ---
  var firstClickCookie = cookieName + '_fcid';
  var firstClickId = '';
  var existingFcid = getCookieValues(firstClickCookie);
  if (existingFcid && existingFcid.length > 0) {
    firstClickId = existingFcid[0];
    setTrackingCookie(firstClickCookie, firstClickId, 365);
  } else if (clickId) {
    firstClickId = clickId;
    setTrackingCookie(firstClickCookie, firstClickId, 365);
  }

  // --- Build pixel URL ---
  var pageUrl = '';
  if (queryPermission('get_url', 'host')) {
    pageUrl = getUrl('host') + getUrl('path');
  }

  var referrer = '';
  if (queryPermission('get_referrer', 'host')) {
    referrer = getReferrerUrl('host') + getReferrerUrl('path');
  }

  var params = 'tid=' + encodeUriComponent(trackingId) +
    '&eid=' + encodeUriComponent(generateEventId()) +
    '&et=' + encodeUriComponent(eventType) +
    '&sid=' + encodeUriComponent(sessionId) +
    '&cid=' + encodeUriComponent(clickId) +
    '&url=' + encodeUriComponent(pageUrl) +
    '&ref=' + encodeUriComponent(referrer) +
    '&ts=' + getTimestampMillis() +
    '&uid=' + encodeUriComponent(userId);

  // Parse mgfclid → community_id, ads_id, match_id
  var mgfParts = parseMgfclid(clickId);
  if (mgfParts.length >= 5) {
    params += '&community_id=' + encodeUriComponent(mgfParts[2]);
    params += '&ads_id=' + encodeUriComponent(mgfParts[3]);
    params += '&match_id=' + encodeUriComponent(mgfParts[4]);
  }

  // First-touch attribution data
  if (firstClickId) {
    params += '&fcid=' + encodeUriComponent(firstClickId);
    var fcParts = parseMgfclid(firstClickId);
    if (fcParts.length >= 5) {
      params += '&fc_community_id=' + encodeUriComponent(fcParts[2]);
      params += '&fc_ads_id=' + encodeUriComponent(fcParts[3]);
    }
  }

  // Optional: event value and currency
  if (data.eventValue) {
    params += '&val=' + encodeUriComponent(data.eventValue);
  }
  if (data.eventCurrency) {
    params += '&cur=' + encodeUriComponent(data.eventCurrency);
  }

  var pixelUrl = endpoint + '?' + params;

  // --- Send ---
  sendPixel(pixelUrl, data.gtmOnSuccess, data.gtmOnFailure);
}

// --- Helper Functions ---

// mgfclid formatı: mgf.1.{communityId}.{adsId}.{matchId}.{timestamp}.{random}
function parseMgfclid(str) {
  if (!str) return [];
  return str.split('.');
}

function generateSessionId() {
  return 's_' + generateRandom(100000000, 999999999) + '_' + getTimestampMillis();
}

function generateEventId() {
  return 'e_' + generateRandom(100000000, 999999999) + '_' + getTimestampMillis();
}

function setTrackingCookie(name, value, days) {
  setCookie(name, value, {
    domain: 'auto',
    path: '/',
    'max-age': days * 24 * 60 * 60,
    secure: true,
    samesite: 'Lax'
  });
}

